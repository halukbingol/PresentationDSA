\NewDocumentCommand{\hSection}{O{#2} m m m}{%
	\section[#1]{#2}%
	\begin{frame}
%		\hRemark{{\center{\Huge {#2}}}}\\
		\begin{center}
			\hRemark{{\Huge {#2}}}\\
			{#3}
			{#4}
		\end{center}
	\end{frame}%
}
\newcommand{\hSubsection}[2]{
	\subsection{{#2}} 
	\begin{frame}
		\hRemark{{\LARGE {#1}}\vspace{0.5cm} {\center{\Huge {#2}}}}\\
	\end{frame}
}
\newcommand{\hSeparator}[2]{
	\begin{frame}
		\hRemark{{\center{\Huge {#1}}}}\\
		{#2}
	\end{frame}
}
