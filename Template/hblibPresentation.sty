% Define colors for syntax highlighting
\definecolor{codegreen}{rgb}{0,0.6,0}
\definecolor{codegray}{rgb}{0.5,0.5,0.5}
\definecolor{codepurple}{rgb}{0.58,0,0.82}
\definecolor{colorback}{rgb}{0.95,0.95,0.92}
\definecolor{coloroutput}{rgb}{0.80,0.80,0.80}



% Define code style
\lstdefinestyle{mystyle}{
    backgroundcolor=\color{colorback},
    commentstyle=\color{codegreen},
    keywordstyle=\color{blue},
    numberstyle=\tiny\color{codegray},
    stringstyle=\color{codepurple},
%    basicstyle=\footnotesize\ttfamily,
%    basicstyle=\fontsize{8}{9}\ttfamily, % Change {font size} {baseline skip}
    basicstyle=\tiny,
    breakatwhitespace=false,
    breaklines=true,
    captionpos=b,
    keepspaces=true,
    numbers=left,
    numbersep=5pt,
    showspaces=false,
    showstringspaces=false,
    showtabs=false,
    tabsize=2,
    morekeywords={public, class, static, void}
}
\lstset{style=mystyle, literate={\ \ }{{\ }}1} % Replaces tabs with spaces


%: ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V \hCodeOutput
\RequirePackage{xargs} % \hCodeOutput

\newcommandx{\hCodeOutput}[3][2=2, 3=0]{
{\tiny 
	\lstinputlisting[style=mystyle, language=Java]
		{#1.src}
	\begin{tikzpicture}[remember picture,overlay]
		\node[anchor=center] at ($(current page.center) + (#2 cm, #3 cm)$) {
			\only<2->{
				\lstset{frameround=tttt}
				\lstinputlisting[style=mystyle, backgroundcolor=\color{coloroutput}, language={},frame=trbl]
				{#1.zzz}
			}
		};
	\end{tikzpicture}
} % fsize
}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A \hCodeOutput





