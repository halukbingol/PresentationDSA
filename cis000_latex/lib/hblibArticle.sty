% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V titles as typed
% amsart prints the title and the authors in CAPITALS and section headings in small caps.
% Here they are printed as typed, and section headings are bold, as in article.
% Other classes are not changed. Option amsheadings switches this off.
% Title: no size commands inside \title (amsart copies it into the page header):
%   \title[Short title]{Long title}
\ifhb@amsheadings\else
	\@ifclassloaded{amsart}{%
		\renewcommand{\uppercasenonmath}[1]{}%                                  title, short title
		\RequirePackage{etoolbox}%
		\patchcmd{\@setauthors}{\MakeUppercase{\authors}}{\authors}{}{}%         authors under the title
		\patchcmd{\maketitle}{\@nx\MakeUppercase{\the\toks@}}{\the\toks@}{}{}% authors in the page header
		\renewcommand{\section}{\@startsection{section}{1}{\z@}%
			{-3.5ex \@plus -1ex \@minus -.2ex}{2.3ex \@plus .2ex}{\normalfont\Large\bfseries}}%
		\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}%
			{-3.25ex\@plus -1ex \@minus -.2ex}{1.5ex \@plus .2ex}{\normalfont\large\bfseries}}%
		\renewcommand{\subsubsection}{\@startsection{subsubsection}{3}{\z@}%
			{-3.25ex\@plus -1ex \@minus -.2ex}{1.5ex \@plus .2ex}{\normalfont\normalsize\bfseries}}%
	}{}
\fi
