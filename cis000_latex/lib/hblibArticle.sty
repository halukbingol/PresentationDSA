%: ===================================================================== 7 Table of contents
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V table of contents
% one size smaller than the text (\small); sections, subsections and subsubsections:
%   1    Introduction           sections: bold (number, title and page), at the left margin
%      1.1   Goal               subsections: indented 1.5em
%           1.1.1   Details     subsubsections: indented 3.8em
% dotted leaders also for sections; less space between sections.
% amsart has its own contents layout, so tocloft is used only with other classes.
% \setcounter{tocdepth}{2} in a document hides the subsubsections again.
\setcounter{tocdepth}{3}
\@ifclassloaded{amsart}{%
	% amsart: \@tocline{level}{space above}{indent}{number width}{font}; empty width = widest number
	\def\l@section{\@tocline{1}{0pt}{0pt}{}{\small\bfseries}}%
	\def\l@subsection{\@tocline{2}{0pt}{1.5em}{}{\small}}%
	\def\l@subsubsection{\@tocline{3}{0pt}{3.8em}{}{\small}}%
}{%
	\RequirePackage{tocloft}
	\renewcommand{\cftsecfont}{\small\bfseries}%            section number and title
	\renewcommand{\cftsecpagefont}{\small\bfseries}%        its page number
	\renewcommand{\cftsubsecfont}{\small}%                  subsections
	\renewcommand{\cftsubsecpagefont}{\small}%
	\renewcommand{\cftsubsubsecfont}{\small}%               subsubsections
	\renewcommand{\cftsubsubsecpagefont}{\small}%
	\renewcommand{\cftsecleader}{\cftdotfill{\cftdotsep}}
	\setlength{\cftbeforesecskip}{2pt}
	\setlength{\cftsecindent}{0pt}%                         sections at the margin
	\setlength{\cftsubsecindent}{1.5em}%                    subsections indented
	\setlength{\cftsubsubsecindent}{3.8em}%                 subsubsections indented more
}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A table of contents



%: ===================================================================== 8 Section numbering
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V section numbering
% The numbering style can switch before any \section:
%   \section{Introduction}      1      subsections 1.1    subsubsections 1.1.1   (the default)
%   \hNumbersLetter{G}
%   \section{Group work}        G      subsections G1     subsubsections G1.1
%   \hNumbersLetter{C}
%   \section{Code}              C      subsections C1     subsubsections C1.1
%   \hNumbersArabic
%   \section{Conclusion}        2      numbers continue where they stopped
% \hNumbersArabic[1]   restarts the numbers at 1 (any number: the number of the next section)
% \hNumbersLetter{G}   the next section gets the letter G (A ... Z); \ref prints G1 etc.
% The default numbering is not changed until one of the two commands is used.
\newcounter{hb@arabicsection}   % the last arabic section number, to continue after the letters
\newcounter{hb@numblock}        % a new block at every switch, so hyperref's link targets stay unique
\newif\ifhb@arabic \hb@arabictrue

\newcommand{\hNumbersArabic}[1][]{%
	\ifhb@arabic\else
		\setcounter{section}{\value{hb@arabicsection}}%                       continue: 1, 2, (G, C), 3
	\fi
	\if\relax\detokenize{#1}\relax\else
		\setcounter{section}{\numexpr#1-1\relax}%                           [next] given
	\fi
	\hb@arabictrue
	\stepcounter{hb@numblock}%
	\renewcommand{\thesection}{\arabic{section}}%                              1
	\renewcommand{\thesubsection}{\thesection.\arabic{subsection}}%            1.1
	\renewcommand{\thesubsubsection}{\thesubsection.\arabic{subsubsection}}%   1.1.1
}

\newcommand{\hNumbersLetter}[1]{%
	\ifhb@arabic \setcounter{hb@arabicsection}{\value{section}}\fi%        remember 1, 2, ...
	\hb@arabicfalse
	\stepcounter{hb@numblock}%
	\setcounter{section}{\numexpr`#1-`A\relax}%                             G is letter 7: counter 6
	\renewcommand{\thesection}{\Alph{section}}%                               G
	\renewcommand{\thesubsection}{\thesection\arabic{subsection}}%            G1
	\renewcommand{\thesubsubsection}{\thesubsection.\arabic{subsubsection}}%  G1.1
}

% the sections of a lab description: W WarmUp, G Goal, C Challenge, H Home
\newcommand{\hSectionChallenge}{\hNumbersLetter{C}\section{Challenge}}
\newcommand{\hSectionGoal}{\hNumbersLetter{G}\section{Goal}}
\newcommand{\hSectionHome}{\hNumbersLetter{H}\section{Home}}
\newcommand{\hSectionWarmUp}{\hNumbersLetter{W}\section{WarmUp}}

% (link targets: see section 10 Hyperlinks)
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A section numbering



%: ===================================================================== 9 Page footer
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V page footer
% every page: a rule, then left the file name and the date, right "page / pages".
% Compile twice: the number of pages is known only after the first run.
\RequirePackage{lastpage}         % \pageref{LastPage} = number of pages
\RequirePackage{fancyhdr}
\fancypagestyle{plain}{%
	\fancyhf{}%                                   clear header and footer
	\renewcommand{\headrulewidth}{0pt}%           no rule under the header
	\renewcommand{\footrulewidth}{1pt}%           a rule above the footer
	\fancyfoot[L]{\small\texttt{\jobname\,\,(\hbTimeStamp)}}%
	\fancyfoot[R]{\small\texttt{\thepage\,/\,\pageref*{LastPage}}}%
}
\pagestyle{plain}
\@ifclassloaded{amsart}{%                         amsart's title page and headings use other styles
	\AtBeginDocument{\pagestyle{plain}}%
	\fancypagestyle{firstpage}{\pagestyle{plain}}%
	\fancypagestyle{headings}{\pagestyle{plain}}%
	\geometry{footskip=24pt}}{}%                    amsart leaves too little room for the footer
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A page footer



%: ===================================================================== 10 Hyperlinks
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V hyperlinks
% clickable contents, references and URLs; loaded last, as hyperref asks
% (hblibDatastructures and hblibCodeoutput may still come after this file).
% Links are framed: red around internal links (contents, \ref, \reffig ...), blue around URLs.
% The boxes are drawn by the PDF viewer only: they are not printed.
% A document can change this after \usepackage{hblibArticle}:
%   \hypersetup{hidelinks}                       no marks at all (the old look)
%   colored text instead of boxes:
%\hypersetup{
%	colorlinks = true,
%	linkcolor  = blue!70!black,    % \ref, \reffig, \refsec ... and the table of contents
%	urlcolor   = blue,             % \url{...}, \href{...}{...}
%	citecolor  = green!50!black,   % \cite{...}
%	filecolor  = magenta           % links to local files
%}
\RequirePackage{hyperref}
\hypersetup{
	colorlinks=false,          % boxes, not colored text
	pdfborder={0 0 1},         % box line 1 pt wide
	linkbordercolor=red,       % internal links
	urlbordercolor=blue        % \url, \href
}

% hyperref names a section's link target after its counter value. With section numbering
% switching, G (counter 7) and a later section 7 would share one; the block number keeps them apart.
\renewcommand{\theHsection}{\arabic{hb@numblock}.\arabic{section}}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A hyperlinks

