%: ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V code: language tag
% \hCodeTag{text}: the next listing shows "text" small and gray at the right end of its first line.
% The tag is drawn by listings at the start of the first printed line (hook EveryPar),
% so it takes no space; a very long first line may run under it.
\newif\ifhCodeTags \hCodeTagstrue            % \hCodeTagsfalse: no tags
\newif\ifhb@tagpending
\newcommand{\hb@tagtext}{}
\newcommand{\hCodeTag}[1]{%
	\ifhCodeTags \gdef\hb@tagtext{#1}\global\hb@tagpendingtrue \fi}
\lst@AddToHook{EveryPar}{%
	\ifhb@tagpending \global\hb@tagpendingfalse
		\rlap{\hbox to \linewidth{\hfill\raisebox{0.15ex}{\tiny\sffamily\color{codecmt}\hb@tagtext}}}%
	\fi}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A code: language tag


%: ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V code: environments, files, inline
% (in beamer: the frame must be [fragile])
\lstnewenvironment{javacode}[1][]{\hCodeTag{java}\lstset{style=javastyle, #1}}{}   % typed Java
\lstnewenvironment{bashcode}[1][]{\hCodeTag{bash}\lstset{style=bashstyle, #1}}{}   % typed bash

\newcommand{\javafile}[2][]{\hCodeTag{java}\lstinputlisting[style=javastyle, numbers=left, #1]{#2}} % Java from a file
\newcommand{\bashfile}[2][]{\hCodeTag{bash}\lstinputlisting[style=bashstyle, #1]{#2}}               % bash from a file

% inline, syntax colored, typed as is; not in titles, captions or footnotes; no % or # inside
\newcommand{\hCodeJ}[1]{\lstinline[style=codestyle, numbers=none, language=Java, basicstyle=\ttfamily\small]{#1}} % Java
\newcommand{\hCodeB}[1]{\lstinline[style=codestyle, numbers=none, language=bash, basicstyle=\ttfamily\small]{#1}} % bash
\newcommand{\code}[1]{\hCodeJ{#1}}                                                                                 % old name
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A code: environments, files, inline



%: ===================================================================== 6 Inline code, sizes
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V inline code and font size
% \hb@fontshift{N}{text}: text N pt larger (N < 0: smaller)
% https://tex.stackexchange.com/questions/365024/decrease-font-size-by-one-point
\newcommand{\hb@fontshift}[2]{%
	\begingroup
		\fontsize{\dimexpr\f@size pt+#1pt}{\f@baselineskip}\selectfont
		#2%
	\endgroup
}
\newcommand{\hFontLarger}[2]{\hb@fontshift{#1}{#2}}  % \hFontLarger{2}{text}: 2 pt larger
\newcommand{\hbFontShift}[2]{\hb@fontshift{#1}{#2}}  % old name (hblibSimple)

\providecolor{colorHCode}{RGB}{240,80,50}           % a document may \definecolor it again
% \hCode{text}: plain inline code, colored, 2 pt smaller; escape \_ \{ \} as in text.
% Works everywhere, also in titles; in a section title the PDF bookmark gets the plain text.
\newcommand{\hb@code}[1]{\hb@fontshift{-2}{\texttt{\color{colorHCode}#1}}}
\newcommand{\hCode}[1]{%
	\ifdefined\texorpdfstring \texorpdfstring{\hb@code{#1}}{#1}\else \hb@code{#1}\fi}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A inline code and font size



