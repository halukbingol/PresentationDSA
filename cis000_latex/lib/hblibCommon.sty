% =====================================================================
%  hblibCommon -- the core of the hb libraries
%  ---------------------------------------------------------------------
%  Do not load it yourself; it is loaded by
%    hblibArticle        articles, exams, lab descriptions (article, amsart)
%    hblibPresentation   slide decks (beamer)
%  Optional, on top of either:
%    hblibDatastructures   arrays, stacks, queues, trees, commit graphs (TikZ)
%    hblibCodeoutput       code and output read from files, in boxes
%  All libraries in one folder: each loads the others from its own folder,
%  e.g. \usepackage{../../hblib/hblibArticle} finds ../../hblib/hblibCommon.
%
%  Old documents: \usepackage{hblibCommon} in an article still works; it loads hblibArticle
%  (and says so in the log).
%
%  Contents of this file (in this order)
%    1  Fonts                 T1, Latin Modern
%    2  Packages              math, graphics, colors, TikZ, tables, trees, dates, menus, listings, algorithms
%    3  Algorithms            algorithm2e set-up
%    4  Colors and emphasis   \hDefined, \hEmph, \hRemark, \hQuestion, ...; \cisOOO, \win, \mac
%    5  Code                  styles; javacode, bashcode, \javafile, \bashfile, \hCodeJ, \hCodeB, \hCodeTag
%    6  Inline code, sizes    \hCode, \hFontLarger
%    7  Time stamps           \hbTimeStamp, \hbTimeStampDraft
%    8  References            \reffig, \refsec, \reftbl, ...
%    9  Text                  \hQuote, \hIdea, \hFootnote, \hAbs, \YULearn
%   10  Tables                column type L{width}
%   11  Old documents         \usepackage{hblibCommon} in an article loads hblibArticle
%
%  Not here: page, lists, titles, contents, footer, hyperlinks (hblibArticle);
%  theme, \hSection (hblibPresentation); the old name "mystyle" (hblibArticle).
% =====================================================================

\edef\hbC@dir{\CurrentFilePath}\edef\hbC@dir{\ifx\hbC@dir\@empty\else\hbC@dir/\fi} % this file's folder

% option amsheadings: kept for old documents (\usepackage[amsheadings]{hblibCommon}); passed to hblibArticle
\DeclareOption{amsheadings}{\def\hb@amsheadingsopt{}}
\DeclareOption*{\PackageWarning{hblibCommon}{Unknown option `\CurrentOption' ignored}}
\ProcessOptions\relax



