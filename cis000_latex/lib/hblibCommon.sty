% start from a clean state, whatever was set globally with \lstset (e.g. a background)
\lstdefinestyle{codeoutreset}{
  backgroundcolor={}, frame=none, frameround=ffff, captionpos=t,
  showspaces=false, showtabs=false, breakatwhitespace=false, morekeywords={}
}

% Turkish and common Latin-1 letters, currency signs, quotes, dashes and no-break spaces
% print in listings (also "mojibake", e.g. "AÄŸaÃ§" for a wrongly decoded "Ağaç")
\lstdefinestyle{utf8letters}{
  literate=
    {ç}{{\c{c}}}1 {Ç}{{\c{C}}}1 {ğ}{{\u{g}}}1 {Ğ}{{\u{G}}}1
    {ı}{{\i}}1    {İ}{{\.I}}1   {ö}{{\"o}}1   {Ö}{{\"O}}1
    {ş}{{\c{s}}}1 {Ş}{{\c{S}}}1 {ü}{{\"u}}1   {Ü}{{\"U}}1
    {é}{{\'e}}1   {è}{{\`e}}1   {ê}{{\^e}}1   {ë}{{\"e}}1
    {á}{{\'a}}1   {à}{{\`a}}1   {â}{{\^a}}1   {ä}{{\"a}}1
    {ã}{{\~a}}1   {å}{{\aa}}1   {í}{{\'i}}1   {î}{{\^i}}1
    {ó}{{\'o}}1   {ô}{{\^o}}1   {ú}{{\'u}}1   {û}{{\^u}}1
    {ñ}{{\~n}}1   {ß}{{\ss}}1   {ÿ}{{\"y}}1   {É}{{\'E}}1
    {Á}{{\'A}}1   {À}{{\`A}}1   {Â}{{\^A}}1   {Ä}{{\"A}}1
    {Ã}{{\~A}}1   {Å}{{\AA}}1   {Î}{{\^I}}1   {Ó}{{\'O}}1
    {Û}{{\^U}}1   {Ÿ}{{\"Y}}1   {§}{{\S}}1
    {ì}{{\`i}}1   {ò}{{\`o}}1   {ù}{{\`u}}1   {Ñ}{{\~N}}1
    {ý}{{\'y}}1   {Ý}{{\'Y}}1   {þ}{{\th}}1   {Þ}{{\TH}}1   {ð}{{\dh}}1   {Ð}{{\DH}}1
    {ï}{{\"i}}1   {Ï}{{\"I}}1   {ﬁ}{{fi}}1   {ﬂ}{{fl}}1   {œ}{{\oe}}1   {æ}{{\ae}}1   {ø}{{\o}}1   {Ø}{{\O}}1
    {€}{{\texteuro}}1 {£}{{\pounds}}1 {¥}{{\textyen}}1 {₺}{{\hbLira}}1 {₹}{{\hbRupee}}1 {°}{{\textdegree}}1
    {’}{{\textquoteright}}1 {‘}{{\textquoteleft}}1
    {“}{{\textquotedblleft}}1 {”}{{\textquotedblright}}1
    {«}{{\guillemetleft}}1 {»}{{\guillemetright}}1 {–}{{--}}1 {—}{{---}}1
    { }{{\ }}1    % U+00A0 no-break space (e.g. "25 %" in German)
    { }{{\,}}1    % U+202F narrow no-break space (e.g. "1 234" in French)
}

% common to code and output: typewriter, no extra letter spacing, long lines broken
\lstdefinestyle{codeoutbase}{
  style=codeoutreset, style=utf8letters,
  basicstyle=\ttfamily\footnotesize, columns=fullflexible, keepspaces=true,
  showstringspaces=false, upquote=true, breaklines=true,
  aboveskip=0pt, belowskip=0pt
}

% program code: colored keywords, strings, comments; line numbers on the left
\lstdefinestyle{codestyle}{
  style=codeoutbase,
  keywordstyle=\color{codekw}\bfseries, stringstyle=\color{codestr},
  commentstyle=\color{codecmt}\itshape,
  numbers=left, numberstyle=\tiny\color{codecmt}, numbersep=5pt, tabsize=4
}

% program output: no colors, no numbers
\lstdefinestyle{outputstyle}{
  style=codeoutbase, language={}, numbers=none, tabsize=8
}

% a terminal transcript: lines starting with "$ " are highlighted commands
% (light text: use it on termbg, e.g. backgroundcolor=\color{termbg}, basicstyle=...\color{termfg})
\lstdefinestyle{terminalstyle}{
  style=outputstyle, morecomment=[f][\color{termcmd}\bfseries]{\$}, commentstyle={}
}

% short code typed in the .tex: framed, light background, no line numbers
\lstdefinestyle{codesnippet}{
  style=codestyle, basicstyle=\ttfamily\footnotesize, numbers=none,
  frame=single, backgroundcolor=\color{codebg}, rulecolor=\color{gray!40},
  xleftmargin=2pt, xrightmargin=2pt, aboveskip=4pt, belowskip=4pt
}

% LaTeX source typed in the .tex: \begin{lstlisting}[style=texsnippet]
\lstdefinestyle{texsnippet}{
  style=codeoutreset, style=utf8letters,
  language={[LaTeX]TeX}, basicstyle=\ttfamily\scriptsize, columns=fullflexible, keepspaces=true,
  breaklines=true, numbers=none,
  frame=single, backgroundcolor=\color{codebg}, rulecolor=\color{gray!40}
}

% the default of every lstlisting, in articles and slides: \begin{lstlisting}[language=Java] ... looks like code
\lstset{style=codestyle}

% Java and bash, with a few newer keywords and commands
\lstdefinestyle{javastyle}{style=codesnippet, language=Java,
  morekeywords={var, record, sealed, permits, yield}}
\lstdefinestyle{bashstyle}{style=codesnippet, language=bash,
  morekeywords={cd, ls, mkdir, javac, java, git, mvn, unzip, tar, echo}}
