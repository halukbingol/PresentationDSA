% Colors can be changed with \definecolor after loading.
\definecolor{codebg}{RGB}{248,248,248}     % code box: background
\definecolor{codeframe}{RGB}{40,90,160}    % code box: frame and title bar (hblibCodeoutput)
\definecolor{codekw}{RGB}{0,70,160}        % keywords
\definecolor{codestr}{RGB}{30,130,60}      % strings
\definecolor{codecmt}{RGB}{120,120,120}    % comments, line numbers, language tags
\definecolor{termbg}{RGB}{35,38,45}        % output and terminal: background (dark)
\definecolor{termfg}{RGB}{225,230,235}     % output and terminal: text
\definecolor{termframe}{RGB}{70,75,85}     % output and terminal: frame
\definecolor{termcmd}{RGB}{255,214,102}    % terminal: lines starting with "$ "

