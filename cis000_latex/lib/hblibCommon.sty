%: ===================================================================== 5 Code
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V code: colors and styles
%   typed code    \begin{javacode} ... \end{javacode}     \begin{bashcode} ... \end{bashcode}
%                 \begin{javacode}[numbers=left] ...       (any listings option in [ ])
%                 \begin{lstlisting}[style=codesnippet, language=Java] ... \end{lstlisting}
