		String s1 = new String("Hello world");
		String s2 = "Hello world";
		String s3 = "Hello world";
		System.out.println("s0:" + s0 + "<");
		System.out.println("s1:" + s1 + "<");
		System.out.println("s2:" + s2 + "<");
		System.out.println("s3:" + s3 + "<");
