System.out.println("\nexample_parsingCsv");
String txt = "aa,45,cccc,dd"//
		+ "\nee,ffff,gggg"//
		+ "\n12,34,789,6543";
//
String[] line = txt.split("[\n]");
for (int i = 0; i < line.length; i++) {
	String[] token = line[i].split("[,]");
	System.out.println("line:" + i + "\t"//
			+ Arrays.toString(token));
}
