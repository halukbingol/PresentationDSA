System.out.println("\nreplacing");
String s = "Hello world";
System.out.println("s:\t"//
		+ s);
System.out.println("s.replace('l', '@'):\t"//
		+ s.replace('l', '@'));
System.out.println("s.replaceFirst(\"l\", \"AA\"):\t"//
		+ s.replaceFirst("l", "AA"));
System.out.println("s.replaceAll(\"l\", \"AA\"):\t"//
		+ s.replaceAll("l", "AA"));
