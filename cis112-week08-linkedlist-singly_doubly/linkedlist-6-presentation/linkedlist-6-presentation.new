% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V
\hSection[Idea]{Why a linked list?}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A




% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V frm
\begin{frame}[t,fragile] \frametitle{Two ways to store a sequence}
  \begin{columns}[T]
    \begin{column}{0.5\textwidth}
      \begin{block}{Array}
        \small
        \hCode{a[0]}, \hCode{a[1]}, \dots, \hCode{a[n-1]} in one block.\\
        Jump to \hCode{a[k]} in $O(1)$.\\
        Insert or delete in the middle: move $n-k$ elements.
      \end{block}
    \end{column}
    \begin{column}{0.46\textwidth}
      \begin{block}{Linked list}
        \small
        Each element lives in its own \textbf{node}, with a
        \hCode{next} reference.\\
        Jump to position $k$: walk from the head ($O(k)$).\\
        Insert or delete: change two references.
      \end{block}
    \end{column}
  \end{columns}
  \vspace{0.4em}
  \small
  \hRemark{Neither is better}: an array is better when you know the
  position; a linked list is better when you know the node.
\end{frame}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A frm




% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V frm
\begin{frame}[t,fragile] \frametitle{What a node is}
  \begin{center}\small
  \begin{tabular}{@{}lll@{}}
    \toprule
    \textbf{Field} & \textbf{Meaning} & \textbf{Java} \\
    \midrule
    data  & the value being stored     & \hCode{int iData} \\
    next  & a reference to the next node, or \hCode{null} & \hCode{Link next} \\
    \bottomrule
  \end{tabular}
  \end{center}
  \vspace{0.4em}
  \small
  A linked list is a chain of such nodes. The list holds a single
  reference, \hCode{first}, to the head of the chain. The last node
  in the chain has \hCode{next == null}.
  \vspace{0.6em}

  \begin{center}
  \begin{tikzpicture}
    \node at (-1.4,0) {\hCode{first}};
    \node[draw, minimum width=1.6cm, minimum height=0.7cm] (a) at (0,0) {};
    \node[font=\ttfamily\scriptsize] at (-0.4,0) {A};
    \node[font=\ttfamily\scriptsize] at ( 0.4,0) {next};
    \draw (a.north) -- (a.south);
    \node[draw, minimum width=1.6cm, minimum height=0.7cm] (b) at (2.3,0) {};
    \node[font=\ttfamily\scriptsize] at (1.9,0) {B};
    \node[font=\ttfamily\scriptsize] at (2.7,0) {next};
    \draw (b.north) -- (b.south);
    \node[draw, minimum width=1.6cm, minimum height=0.7cm] (c) at (4.6,0) {};
    \node[font=\ttfamily\scriptsize] at (4.2,0) {C};
    \node[font=\ttfamily\scriptsize] at (5.0,0) {next};
    \draw (c.north) -- (c.south);
    \node at (6.3,0) {\hCode{null}};
    \draw[-latex] (-0.85,0) -- (a.west);
    \draw[-latex] (a.east)  -- (b.west);
    \draw[-latex] (b.east)  -- (c.west);
    \draw[-latex] (c.east)  -- (5.95,0);
  \end{tikzpicture}
  \end{center}
  \vspace{0.2em}
  \small This list has three nodes: A, B, C, then \hCode{null}.
\end{frame}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A frm

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V
\hSection[Shapes]{Nodes and Edges}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A




% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V frm
\begin{frame}[t,fragile] \frametitle{ADT with nodes and edges}
  \begin{center}\footnotesize
  \begin{tabular}{@{}lll@{}}
    \toprule
    \textbf{Structure} & \textbf{Shape} & \textbf{Node has} \\
    \midrule
    Linked list & linear       & \hCode{next} \\
    Tree        & hierarchical & \hCode{left}, \hCode{right} (or \hCode{children}) \\
    Heap        & complete binary tree with the heap order & \hCode{left}, \hCode{right} \\
    Graph       & non-linear   & a list of neighbours \\
    \bottomrule
  \end{tabular}
  \end{center}
  \vspace{0.3em}
  \small
  All four are the same idea: a set of nodes, each holding data and a
  set of edges to other nodes. \hRemark{The linked list is the simplest one.}
\end{frame}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A frm




% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V frm
\begin{frame}[t,fragile] \frametitle{A tree is a linked list with two nexts}
  \begin{columns}[T]
    \begin{column}{0.46\textwidth}
      \begin{itemize}\small
        \item Each node has \hCode{left} and \hCode{right}.
        \item \hCode{null} means ``no child there''.
        \item Traversal is a walk, not a jump: you still go through
              references.
        \item Binary search tree: order by key.
      \end{itemize}
    \end{column}
    \begin{column}{0.5\textwidth}
      \begin{block}{What changes, what stays}
        \small
        Same node idea.\\
        Same reference-by-reference traversal.\\
        Different order: by depth, by key, by BFS/DFS.
      \end{block}
    \end{column}
  \end{columns}
\end{frame}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A frm




% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V frm
\begin{frame}[t,fragile] \frametitle{A heap is a tree with an order}
  \begin{itemize}\small
    \item Complete binary tree: filled left to right, level by level.
    \item Heap order: parent $\le$ child (min-heap) or parent $\ge$ child (max-heap).
    \item Same node and reference idea; different invariant.
    \item The \hCode{PriorityQueue} in the Java API is a binary heap
          stored in an array, not in nodes.
  \end{itemize}
  \begin{block}{The invariant is the data structure}
    \small
    A linked list has no invariant between neighbours.
    A heap has one. A search tree has one. That is what makes them
    different algorithms on the same node-and-reference idea.
  \end{block}
\end{frame}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A frm




% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V frm
\begin{frame}[t,fragile] \frametitle{A graph is nodes and edges, unrestricted}
  \begin{itemize}\small
    \item Each node has a list of adjacent nodes.
    \item No linear order is implied.
    \item Directed or undirected; a self-loop is an edge from a node to itself.
    \item BFS and DFS run on graphs and use --- respectively --- a queue and a stack.
  \end{itemize}
  \vspace{0.3em}
  \small
  \hRemark{The linked list, the tree and the heap are special cases of a graph.}
  The stack and the queue can also be drawn as graphs; the next slides show why.
\end{frame}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A frm




% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V frm
\begin{frame}[t,fragile] \frametitle{First run: a chain and its traversal}
  \begin{columns}[T]
    \begin{column}{0.52\textwidth}
      \lstcode[basicstyle=\ttfamily\tiny]{codeoutput/NodeChain.java}{Java}
    \end{column}
    \begin{column}{0.44\textwidth}
      \lstterminal[basicstyle=\ttfamily\scriptsize]{codeoutput/NodeChain.txt}
      \small
      \hRemark{Forward only}: there is no \hCode{chain.get(3)}.
    \end{column}
  \end{columns}
\end{frame}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A frm

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V
\hSection[Trade]{What You Pay and What You Gain}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A




% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V frm
\begin{frame}[t,fragile] \frametitle{The trade}
  \begin{center}\small
  \begin{tabular}{@{}lll@{}}
    \toprule
    \textbf{Operation} & \textbf{Array} & \textbf{Linked list} \\
    \midrule
    access \hCode{a[k]}        & $O(1)$ & $O(k)$ \\
    insert at front            & $O(n)$ & $O(1)$ \\
    delete at front            & $O(n)$ & $O(1)$ \\
    insert at rear             & $O(1)$ amort. & $O(1)$ with \hCode{last} \\
    insert in middle (given the node) & $O(n)$ & $O(1)$ \\
    search by value            & $O(n)$ & $O(n)$ \\
    memory                     & contiguous, compact & one node per element \\
    \bottomrule
  \end{tabular}
  \end{center}
  \vspace{0.3em}
  \small
  \hRemark{The trick}: insert and delete change two references,
  not the elements. The rest of the list never moves.
\end{frame}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A frm




% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V frm
\begin{frame}[t,fragile] \frametitle{Structure of a singly linked list}
  \begin{center}
  \begin{tikzpicture}
    \node at (-1.4,0) {\hCode{first}};
    \node[draw, minimum width=1.6cm, minimum height=0.7cm] (a) at (0,0) {};
    \node[font=\ttfamily\scriptsize] at (-0.4,0) {A};
    \node[font=\ttfamily\scriptsize] at ( 0.4,0) {next};
    \draw (a.north) -- (a.south);
    \node[draw, minimum width=1.6cm, minimum height=0.7cm] (b) at (2.3,0) {};
    \node[font=\ttfamily\scriptsize] at (1.9,0) {B};
    \node[font=\ttfamily\scriptsize] at (2.7,0) {next};
    \draw (b.north) -- (b.south);
    \node[draw, minimum width=1.6cm, minimum height=0.7cm] (c) at (4.6,0) {};
    \node[font=\ttfamily\scriptsize] at (4.2,0) {C};
    \node[font=\ttfamily\scriptsize] at (5.0,0) {next};
    \draw (c.north) -- (c.south);
    \node at (6.3,0) {\hCode{null}};
    \draw[-latex] (-0.85,0) -- (a.west);
    \draw[-latex] (a.east)  -- (b.west);
    \draw[-latex] (b.east)  -- (c.west);
    \draw[-latex] (c.east)  -- (5.95,0);
  \end{tikzpicture}
  \end{center}
  \vspace{0.4em}
  \begin{itemize}\small
    \item One reference (\hCode{first}) is enough to find every node.
    \item The list has no \hCode{last} unless you add one.
    \item Every node is reached through the previous node's \hCode{next}.
  \end{itemize}
\end{frame}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A frm




% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V frm
\begin{frame}[t,fragile] \frametitle{You can only walk forward}
  \begin{block}{Sequential access}
    \small
    To reach position $k$, start at \hCode{first} and follow
    \hCode{next} $k$ times. \hRemark{There is no \texttt{a[k]} in a linked list.}
  \end{block}
  \vspace{0.3em}
  \begin{itemize}\small
    \item Iteration is the normal way to visit every element.
    \item Any algorithm that jumps by index is the wrong fit.
    \item The JDK's \hCode{LinkedList.get(i)} is $O(i)$, which is why
          you use it as a \hCode{Deque}, not as a \hCode{List}.
  \end{itemize}
\end{frame}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A frm




% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V frm
\begin{frame}[t,fragile] \frametitle{Insert at the head}
  \begin{columns}[T]
    \begin{column}{0.48\textwidth}
      \begin{enumerate}\small
        \item Create the new node.
        \item Point its \hCode{next} to the old \hCode{first}.
        \item Point \hCode{first} at the new node.
      \end{enumerate}
    \end{column}
    \begin{column}{0.48\textwidth}
      \begin{block}{Two references}
        \small
        The rest of the list is untouched. $O(1)$.
      \end{block}
    \end{column}
  \end{columns}
\end{frame}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A frm




% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V frm
\begin{frame}[t,fragile] \frametitle{Delete at the head}
  \begin{columns}[T]
    \begin{column}{0.48\textwidth}
      \begin{enumerate}\small
        \item Save the old \hCode{first}.
        \item Advance \hCode{first} to \hCode{first.next}.
        \item Return the saved node's data.
      \end{enumerate}
    \end{column}
    \begin{column}{0.48\textwidth}
      \begin{block}{One reference}
        \small
        The removed node becomes unreachable; the GC reclaims it. $O(1)$.
      \end{block}
    \end{column}
  \end{columns}
\end{frame}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A frm




% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V frm
\begin{frame}[t,fragile] \frametitle{Insert at the tail}
  \begin{itemize}\small
    \item Without a \hCode{last} reference: walk from \hCode{first} to
          the end, then attach. $O(n)$.
    \item With a \hCode{last} reference: attach at \hCode{last},
          then move \hCode{last}. $O(1)$.
  \end{itemize}
  \vspace{0.4em}
  \begin{block}{Double-ended list}
    \small
    \hCode{FirstLastList} keeps both \hCode{first} and \hCode{last}.
    That is the whole difference between a stack (only needs
    \hCode{first}) and a queue (needs both).
  \end{block}
\end{frame}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A frm




% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V frm
\begin{frame}[t,fragile] \frametitle{The JDK gives you both: \texttt{ArrayList} and \texttt{LinkedList}}
  \small
  The abstract array and the abstract linked list have concrete names
  in \hCode{java.util}.
  \vspace{0.2em}
  \begin{columns}[T]
    \begin{column}{0.48\textwidth}
      \begin{block}{\texttt{ArrayList<E>}: the array}
        \small
        \begin{itemize}
          \item one resizable \hCode{Object[]}
          \item \hCode{get(i)}: $O(1)$
          \item \hCode{add(0, x)}: $O(n)$ (shift right)
          \item \hCode{remove(0)}: $O(n)$ (shift left)
          \item iterate: cache-friendly
        \end{itemize}
      \end{block}
    \end{column}
    \begin{column}{0.48\textwidth}
      \begin{block}{\texttt{LinkedList<E>}: the chain}
        \small
        \begin{itemize}
          \item one node per element, \hCode{next} and \hCode{prev}
          \item \hCode{get(i)}: $O(i)$ (walk from \hCode{first})
          \item \hCode{add(0, x)}: $O(1)$ (relink)
          \item \hCode{remove(0)}: $O(1)$ (relink)
          \item iterate: pointer chasing
        \end{itemize}
      \end{block}
    \end{column}
  \end{columns}
  \vspace{0.3em}
  \begin{block}{Same \texttt{List<E>} interface, different internals}
    \small
    \hCode{List<Integer> xs = new ArrayList<>();} and
    \hCode{List<Integer> xs = new LinkedList<>();} are interchangeable
    at the call site. The choice is about \emph{workload}, not about the API.
    \hRemark{\texttt{LinkedList} is doubly linked}, which is why it can
    also be used as a \hCode{Deque} --- see the next section.
  \end{block}
\end{frame}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A frm

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V
\hSection[Doubly]{Doubly Linked}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A




% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V frm
\begin{frame}[t,fragile] \frametitle{A node with two references}
  \begin{center}
  \begin{tikzpicture}[
    arr/.style     = {-{Latex[length=2mm]}, thick},
    lbl/.style     = {font=\ttfamily\scriptsize},
    nd/.style      = {draw, thick, minimum width=1.0cm, minimum height=1.8cm, fill=gray!20},
    hdr/.style     = {draw, thick, minimum width=1.0cm, minimum height=1.8cm, fill=gray!30},
    databox/.style = {draw, thick, minimum width=0.7cm, minimum height=0.3cm, fill=white}
  ]

    % Header (the FirstLastList object itself)
    \node[hdr] (h) at (0,0) {};
    \node[lbl] at (0,  0.5) {first};
    \node[lbl] at (0, -0.5) {last};

    % Four nodes
    % data box at y=+0.5, next at y=0.0, prev at y=-0.5
    \foreach \i/\px/\dc in {1/2.2/A, 2/4.2/B, 3/6.2/C, 4/8.2/D} {
      \node[nd] (n\i) at (\px, 0) {};
      \node[databox] at (\px, 0.5) {\scriptsize \dc};
      \node[lbl, anchor=west] at (\px-0.4, 0.0)  {next};
      \node[lbl, anchor=west] at (\px-0.4, -0.5) {prev};
    }

    % first -> n1  (horizontal at the data level)
    \draw[arr] (0.5, 0.5) -- (1.7, 0.5);

    % next chain: n1 -> n2 -> n3 -> n4
    \draw[arr] (2.7, 0.0) -- (3.7, 0.0);
    \draw[arr] (4.7, 0.0) -- (5.7, 0.0);
    \draw[arr] (6.7, 0.0) -- (7.7, 0.0);

    % n4 next -> null (right)
    \draw[arr] (8.7, 0.0) -- (9.0, 0.0);
    \node[lbl, anchor=west] at (9.05, 0.0) {null};

    % prev chain: n4 -> n3 -> n2 -> n1
    \draw[arr] (7.7, -0.5) -- (6.7, -0.5);
    \draw[arr] (5.7, -0.5) -- (4.7, -0.5);
    \draw[arr] (3.7, -0.5) -- (2.7, -0.5);

    % n1 prev -> null (left)
    \draw[arr] (1.7, -0.5) -- (1.45, -0.5);
    \node[lbl, anchor=east] at (1.4, -0.5) {null};

    % last -> n4  (down from the bottom of the header, along the bottom, up into node 4)
    \draw[arr] (0, -0.9) -- (0, -1.35) -- (8.2, -1.35) -- (8.2, -0.9);

  \end{tikzpicture}
  \end{center}
  \vspace{0.3em}
  \begin{itemize}\small
    \item Each node holds three fields: \hCode{data}, \hCode{next}, \hCode{prev}.
    \item The list keeps both ends: \hCode{first} at the head,
          \hCode{last} at the tail.
    \item Cost: one extra reference per element.
    \item Benefit: every operation on the two ends is $O(1)$,
          and iteration can go either way.
  \end{itemize}
\end{frame}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A frm




% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V frm
\begin{frame}[t,fragile] \frametitle{What \texttt{prev} buys you}
  \begin{columns}[T]
    \begin{column}{0.52\textwidth}
      \lstcode[basicstyle=\ttfamily\tiny]{codeoutput/JavaContainers.java}{Java}
    \end{column}
    \begin{column}{0.44\textwidth}
      \lstterminal[basicstyle=\ttfamily\scriptsize]{codeoutput/JavaContainers.txt}
      \small
      \begin{itemize}
        \item \hCode{getLast()} and \hCode{removeLast()} would need a
              walk on a singly linked list; here they go through
              \hCode{last.prev} and are $O(1)$.
        \item Peeling from the back (\hCode{removeLast()}) is
              symmetric to peeling from the front.
      \end{itemize}
    \end{column}
  \end{columns}
\end{frame}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A frm

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V
\hSection[Uses]{Uses and Wrap-up}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A




% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V frm
\begin{frame}[t,fragile] \frametitle{Where a linked list wins}
  \begin{columns}[T]
    \begin{column}{0.48\textwidth}
      \begin{itemize}\small
        \item FIFO or LIFO where the number of elements is not known
              in advance.
        \item Splicing two sequences (LRU cache, undo/redo).
        \item Music playlists (insert in the middle, skip to next).
        \item The bucket chain of a hash table.
        \item Adjacency lists of a graph.
      \end{itemize}
    \end{column}
    \begin{column}{0.48\textwidth}
      \begin{block}{Where it loses}
        \small
        \begin{itemize}
          \item Random access by index.
          \item Cache-sensitive hot loops.
          \item Anything where you know the array size up front.
        \end{itemize}
      \end{block}
    \end{column}
  \end{columns}
\end{frame}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A frm




% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V frm
\begin{frame}[t,fragile] \frametitle{Big ideas}
  \begin{itemize}
    \item A linked list is a chain of \textbf{nodes}, each with a data
          field and a \hCode{next} reference.
    \item The list object holds only \hCode{first}; \hCode{last} is
          optional and makes enqueue $O(1)$.
    \item A stack is a linked list with only \hCode{first}; a queue is a
          linked list with \hCode{first} and \hCode{last}.
    \item A doubly linked list adds \hCode{prev}, so deletion no
          longer needs the previous node.
    \item Trees, heaps and graphs are the same node-and-edge idea with
          an invariant. A linked list is the simplest case.
    \item \hRemark{You cannot jump}; every access walks.
  \end{itemize}
\end{frame}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A frm




% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V frm
\begin{frame}[t,fragile] \frametitle{Check yourself}
  \begin{enumerate}\small
    \item What does a node hold that an array element does not?
    \item Why is \hCode{insertFirst} $O(1)$ but \hCode{get(k)} $O(k)$?
    \item Why does a queue need \hCode{last} but a stack does not?
    \item What does a doubly linked node hold that a singly linked
          node does not?
    \item Name three of the four node-and-edge structures from the PPTX.
    \item When would you pick \hCode{LinkedList} over \hCode{ArrayList}
          in the JDK?
  \end{enumerate}
\end{frame}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A frm




% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V frm
\begin{frame}[t,fragile] \frametitle{References}
  \begin{enumerate}\small
    \item Robert Lafore, \emph{Data Structures \& Algorithms in Java},
          2nd ed., Sams, 2002.
          \newline
          The \hCode{Link} / \hCode{LinkList} / \hCode{FirstLastList}
          style reused in the freshman deck.
    \item Thomas H. Cormen, Charles E. Leiserson, Ronald L. Rivest,
          Clifford Stein, \emph{Introduction to Algorithms}, 4th ed.,
          MIT Press, 2022.
          \newline
          Chapter 10: elementary data structures, linked lists,
          stacks, queues.
    \item Robert Sedgewick and Kevin Wayne, \emph{Algorithms},
          4th ed., Addison-Wesley, 2011.
          \newline
          Section 1.3: linked lists; Section 3.1: symbol tables
          built on them.
    \item \emph{8 Basic Data Structures Every Programmer Should Know},
          GoDaddy Resources.
          \newline
          \url{https://www.godaddy.com/resources/in/web-pro-in/8-basic-data-structures-every-programmer-should-know}
          \newline
          The source for the node-and-edge survey (list, tree,
          heap, graph) on slides 3--7 of the deck.
    \item Oracle, \emph{Java SE 21 API Specification}.
          \newline
          \hCode{java.util.LinkedList}, \hCode{java.util.List},
          \hCode{java.util.Deque}.
    \item Oracle, \emph{The Java Tutorials: Trail: Collections}.
  \end{enumerate}
\end{frame}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A frm

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V
\hSection[PPTX]{The Two Exercises from previous years}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A




% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V frm
\begin{frame}[t,fragile] \frametitle{Stutter: duplicate every element}
  \begin{columns}[T]
    \begin{column}{0.54\textwidth}
      \lstcode[basicstyle=\ttfamily\tiny]{codeoutput/Stutter.java}{Java}
    \end{column}
    \begin{column}{0.42\textwidth}
      \lstterminal[basicstyle=\ttfamily\scriptsize]{codeoutput/Stutter.txt}
      \small
      \begin{itemize}
        \item Build a new list with each element twice, then swap it in.
        \item \hCode{[1, 2, 3, 4]} $\to$ \hCode{[1, 1, 2, 2, 3, 3, 4, 4]}.
        \item One pass, $O(n)$ time, $O(n)$ extra space.
      \end{itemize}
    \end{column}
  \end{columns}
\end{frame}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A frm




% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V frm
\begin{frame}[t,fragile] \frametitle{Mirror: append the reverse of itself}
  \begin{columns}[T]
    \begin{column}{0.54\textwidth}
      \lstcode[basicstyle=\ttfamily\tiny]{codeoutput/Mirror.java}{Java}
    \end{column}
    \begin{column}{0.42\textwidth}
      \lstterminal[basicstyle=\ttfamily\scriptsize]{codeoutput/Mirror.txt}
      \small
      \begin{itemize}
        \item Copy the list, reverse the copy, append it.
        \item \hCode{[1, 2, 3, 4]} $\to$ \hCode{[1, 2, 3, 4, 4, 3, 2, 1]}.
        \item Symmetric input is a palindrome; the deque version needs no copy.
      \end{itemize}
    \end{column}
  \end{columns}
\end{frame}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A frm

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V
\hSection[Classic]{Classic Problems}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A




% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V frm
\begin{frame}[t,fragile] \frametitle{Reverse in place}
  \begin{columns}[T]
    \begin{column}{0.54\textwidth}
      \lstcode[basicstyle=\ttfamily\tiny]{codeoutput/ReverseList.java}{Java}
    \end{column}
    \begin{column}{0.42\textwidth}
      \lstterminal[basicstyle=\ttfamily\scriptsize]{codeoutput/ReverseList.txt}
      \small
      \begin{itemize}
        \item Three pointers, one pass: \hCode{prev}, \hCode{cur}, \hCode{next}.
        \item Redirect each \hCode{next} backwards, then advance.
        \item $O(n)$ time, $O(1)$ space, no new nodes.
      \end{itemize}
    \end{column}
  \end{columns}
\end{frame}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A frm




% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V frm
\begin{frame}[t,fragile] \frametitle{Palindrome check}
  \begin{columns}[T]
    \begin{column}{0.54\textwidth}
      \lstcode[basicstyle=\ttfamily\tiny]{codeoutput/Palindrome.java}{Java}
    \end{column}
    \begin{column}{0.42\textwidth}
      \lstterminal[basicstyle=\ttfamily\scriptsize]{codeoutput/Palindrome.txt}
      \small
      \begin{itemize}
        \item Two indices, one from each end, meet in the middle.
        \item \hCode{r a c e c a r} $\to$ \hCode{true};
              \hCode{a b c} $\to$ \hCode{false}.
        \item On a linked list without \hCode{get(i)}, the same idea
              needs a stack or a recursion.
      \end{itemize}
    \end{column}
  \end{columns}
\end{frame}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A frm




% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V frm
\begin{frame}[t,fragile] \frametitle{Josephus problem}
  \begin{columns}[T]
    \begin{column}{0.54\textwidth}
      \lstcode[basicstyle=\ttfamily\tiny]{codeoutput/Josephus.java}{Java}
    \end{column}
    \begin{column}{0.42\textwidth}
      \lstterminal[basicstyle=\ttfamily\scriptsize]{codeoutput/Josephus.txt}
      \small
      \begin{itemize}
        \item $n$ people in a circle, every $k$-th is removed.
        \item For $n = 7$, $k = 3$, the survivor is $4$.
        \item A circular list is the natural model; the array version
              is $O(n^2)$, the linked version $O(nk)$.
      \end{itemize}
    \end{column}
  \end{columns}
\end{frame}
