public class MyNode<T> implements NodeBinaryI<T>{

	public T data;
	public MyNode<T> left;
	public MyNode<T> right;

	public MyNode() {
		this(null);
	}

	public MyNode(T data) {
		this.data = data;
		left = null;
		right = null;
	}

	...
	
	@Override
	public String toString() {
		return "[MyNode: data=" + data + "]";
	}

}