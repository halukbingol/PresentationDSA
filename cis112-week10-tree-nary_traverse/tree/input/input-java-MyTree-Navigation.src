public class MyBinaryTree<T> {

	private MyNode<T> root;

	...
		
	public T data() {
		return root.data;
	}

	public MyBinaryTree<T> left() {
		MyBinaryTree<T> tree = new MyBinaryTree<>();
		tree.root = root.left;
		return tree;
	}

	public MyBinaryTree<T> right() {
		MyBinaryTree<T> tree = new MyBinaryTree<>();
		tree.root = root.right;
		return tree;
	}

	public boolean isEmpty() {
		return root == null;
	}

}