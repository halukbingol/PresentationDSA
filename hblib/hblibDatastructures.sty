%: ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V Queue
% Define \hQueue macro
% if \first=1 then index=0 is not used. Queue starts at index=0
%                else Queue starts at index=1.
% See CLRS
\NewDocumentCommand{\hQueue}{m m m m m O{0.8} O{0.6}}{ 
	\edef\first{#1}  % first index: 0 or 1
	\edef\capacity{#2}  % capacity
	\edef\head{#3}  % index of head
	\edef\tail{#4}  % index of tail
	\edef\content{#5} % comma separated list
	\def\width{#6} % box width
	\def\height{#7} % box height
	
%% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V debug
%	\show{#1}
%	\MARK
%	\showtokens{#1}
%	\@@end
%	\end
%% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A debug
	%
	\def\xhh{\width/4} % x displacement for head mark
	\def\xff{\width*3/4} % x displacement for  tail mark
	\def\y{-.3} % y 
	\def\yshf{\y+\height/4} % y displacement for mark
	\def\yindex{\y+\height-0.06} % y displacement for indices
	
	
	% filled rectangles
	% index=0
	\ifnum\first=1
		\filldraw[fill=colorBoxZero] (0,\y) rectangle +(\width,\height);
		\node[colorIndex] at (\width/2,\yindex) {{\tiny 0}}; % index 0
	\fi
	% index>0
	\foreach \j in {1,...,\capacity} {
		\ifnum\first=1
			\FPeval{i}{clip(\j)};
		\else
			\FPeval{i}{clip(\j-1)};
		\fi
		\FPeval{x}{clip(\i*\width)};

%% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V debug
%\FPeval{yDebug}{clip(\i*\height)};
%\node at (\x,\yDebug) {{\tiny j=\j, i=\i}}; % debug
%% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A debug
		\ifnum\head>\tail
			% circlular started
			\ifnum\i<\tail 
				\filldraw[fill=colorUsed] (\x,\y) rectangle +(\width,\height);
			\fi
			\ifnum\i>\tail 
				\ifnum\i<\head 
					\filldraw[fill=colorUnused] (\x,\y) rectangle +(\width,\height);
				\fi
				\ifnum\i>\head 
					\filldraw[fill=colorUsed] (\x,\y) rectangle +(\width,\height);
				\fi
			\fi
		\else
			% \head <= \tail
			% circular is not started yet
			\ifnum\i<\head 
				\filldraw[fill=colorUnused] (\x,\y) rectangle +(\width,\height);
				%\node[red] at (0.5,0.2*\i) {{\tiny O1:\i }}; %---------------
			\fi
			\ifnum\i>\head 
				\ifnum\i<\tail 
					\filldraw[fill=colorUsed] (\x,\y) rectangle +(\width,\height);
					%\node[red] at (1,0.2*\i) {{\tiny I:\i }}; %---------------
				\fi
				\ifnum\i>\tail 
					\filldraw[fill=colorUnused] (\x,\y) rectangle +(\width,\height);
					%\node[red] at (2,0.2*\i) {{\tiny O2:\i }}; %---------------
				\fi
			\fi
		\fi % \head>\tail
		
		\ifnum\i=\head 
			\ifnum\i=\tail 
				% empty
				\filldraw[fill=colorEmpty] (\x,\y) rectangle +(\width,\height);
				\node[colorLabel] at (\x+\xff,\yshf) {{\tiny t}};
				\node[colorLabel] at (\x+\xhh,\yshf) {{\tiny h}};
				%\node[red] at (0.4,1) {{\tiny T:\i}}; %---------------
			\else
				\filldraw[fill=colorHead] (\x,\y) rectangle +(\width,\height);
				\node[colorLabel] at (\x+\xhh,\yshf) {{\tiny h}};
				%\node[red] at (0,1) {{\tiny H:\i }}; %---------------
			\fi
		\fi
		\ifnum\i=\tail 
			\ifnum\i=\head
				% empty
				\filldraw[fill=colorEmpty] (\x,\y) rectangle +(\width,\height);
				\node[colorLabel] at (\x+\xff,\yshf) {{\tiny t}};
				\node[colorLabel] at (\x+\xhh,\yshf) {{\tiny h}};
				%\node[red] at (0.4,1) {{\tiny T:\i}}; %---------------
			\else
				\filldraw[fill=colorTail] (\x,\y) rectangle +(\width,\height);
				\node[colorLabel] at (\x+\xff,\yshf) {{\tiny t}};
				%\node[red] at (0.4,1) {{\tiny T:\i}}; %---------------
			\fi
		\fi
		
		% index
		\FPeval{xindex}{\i*\width+\width/2};
		\node[colorIndex] at (\xindex,\yindex) {{\tiny \i}}; % index
	} % foreach
		
	% draw the elements
	\foreach \elem [count=\i] in \content {
		\ifnum\first=1
			\FPeval{j}{\i}
		\else
			\FPeval{j}{clip(\i-1)}
		\fi
		\FPeval{x}{\j*\width+\width/2};
		\node at (\x,\y+\height/2) {{\scriptsize \elem}}; % content
	}
} % \hQueue
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A Queue





%: ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V Stack
% Define \stack macro
% if \first=1 then index=0 is not used. Stack starts at index=0
%                else Stack starts at index=1.
% See CLRS
\NewDocumentCommand{\hStack}{m m m m O{0.5} O{0.5}}{ 
	\edef\first{#1}  % first index: 0 or 1
	\edef\capacity{#2}  % capacity
	\edef\top{#3}  % index of top
	\edef\content{#4} % comma separated list
	\def\width{#5} % box width
	\def\height{#6} % box height
	%
	\def\xtt{\width*7/8} % x displacement for  top mark
	\def\y{-.3} % y 
	\def\yshf{\y+\height/4} % y displacement for stack, head. tail mark
	\def\yindex{\y+\height-0.06} % y displacement for indices

	% Draw  rectangles
	% index=0
	\ifnum\first=1
		\filldraw[fill=colorBoxZero] (0,\y) rectangle +(\width,\height);
		\node[colorIndex] at (\width/2,\yindex) {{\tiny 0}}; % index 0
	\fi
	% index>0
	\foreach \j in {1,...,\capacity} {
		\ifnum\first=1
			\FPeval{i}{clip(\j)};
		\else
			\FPeval{i}{clip(\j-1)};
		\fi
		\FPeval{x}{clip(\i*\width)};
	
		\ifnum\i<\top 
			% box is in the stack
			\filldraw[fill=colorUsed] (\x,\y) rectangle +(\width,\height);
		\fi
		\ifnum\i=\top 
			% box is the top element
			\filldraw[fill=colorTop] (\x,\y) rectangle +(\width,\height);
			\node[red] at (\x+\xtt,\yshf) {{\tiny t}};
		\fi
		\ifnum\i>\top 
			% box is not in the stack
			\filldraw[fill=colorUnused] (\x,\y) rectangle +(\width,\height);
		\fi
		
		% index
		\FPeval{xindex}{\i*\width+\width/2};
		\node[colorIndex] at (\xindex,\yindex) {{\tiny \i}}; % index
	}
	% draw the elements
	\foreach \elem [count=\i] in \content {
		\ifnum\first=1
			\FPeval{j}{\i}
		\else
			\FPeval{j}{clip(\i-1)}
		\fi
		\FPeval{x}{\j*\width+\width/2};
		\node at (\x,\y+\height/2) {{\scriptsize \elem}}; % content
	}
}  % \hStack 
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A Stack




%: ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V String
% \hString[box width]{c,h,a,r,s}[from][to]   (use inside a tikzpicture)
% One box per character with its 0-based index above it.
% Boxes from <= i < to are highlighted, as in s.substring(from, to).
% A space can be given as \textvisiblespace.
\NewDocumentCommand{\hString}{O{0.45} m O{-1} O{-1}}{%
	\foreach \hb@c [count=\hb@i from 0] in {#2} {%
		\ifnum\hb@i<#3\relax \def\hb@fill{white}%
		\else\ifnum\hb@i<#4\relax \def\hb@fill{colorHead}%
		\else \def\hb@fill{white}\fi\fi
		\filldraw[fill=\hb@fill] (\hb@i*#1,0) rectangle +(#1,#1);
		\node[font=\ttfamily\small, text height=1.6ex, text depth=0.3ex, inner sep=0pt]
			at (\hb@i*#1+#1/2,#1/2) {\hb@c};
		\node[colorIndex, font=\tiny] at (\hb@i*#1+#1/2,#1+0.14) {\hb@i};
	}%
} % \hString
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A String




%: ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V Array
% \hArray[keys]{e0,e1,...}   (use inside a tikzpicture)
% One box per element with its 0-based index; like \hString, but with keys.
% Cell i is also a node named (<id>-i), e.g. (a-0.west), (a-4.south), for arrows and labels.
% Keys (all optional):
%   id=a            node names a-0, a-1, ...         (default hA)
%   at={(x,y)}      lower-left corner of cell 0      (default (0,0))
%   width=0.6       box width in cm                  height=0.5   box height in cm
%   name=scores     a label left of the array        index=above, below or none
%   hot={2}         highlighted cells  (colorHead)   cur={3}      the current cell (colorTop)
%   done={0,1}      visited cells (colorUsed!55)     unused={5,...,7}  unused cells (colorUnused)
%   font=\ttfamily\small                             the font of the elements
% Lists use \foreach syntax, e.g. hot={0,...,3}. A space can be given as \textvisiblespace.
% A reference variable and its arrow:
%   \node[hvar] (v) at (-1.5,0.25) {}; \draw[href] (v.center) -- (a-0.west);
\pgfkeys{/hArray/.is family, /hArray,
	id/.store in=\hb@aid,
	at/.store in=\hb@aat,
	width/.store in=\hb@aw,
	height/.store in=\hb@ah,
	name/.store in=\hb@aname,
	index/.store in=\hb@aindex,
	hot/.store in=\hb@ahot,
	cur/.store in=\hb@acur,
	done/.store in=\hb@adone,
	unused/.store in=\hb@aunused,
	font/.store in=\hb@afont,
	defaults/.style={id=hA, at={(0,0)}, width=0.6, height=0.5, name=, index=above,
		hot=, cur=, done=, unused=, font=\ttfamily\small}
}
% \hb@afill{list}{color}: fill the cells in the list
\newcommand{\hb@afill}[2]{%
	\ifx#1\@empty\else
		\foreach \hb@k in #1 {%
			\fill[#2] (\hb@k*\hb@aw,0) rectangle +(\hb@aw,\hb@ah);}%
	\fi}
\NewDocumentCommand{\hArray}{O{} m}{%
	\begingroup
	\pgfkeys{/hArray, defaults, #1}%
	\expandafter\hb@abegin\expandafter{\hb@aat}%
	\hb@afill\hb@aunused{colorUnused}%
	\hb@afill\hb@adone{colorUsed!55}%
	\hb@afill\hb@ahot{colorHead}%
	\hb@afill\hb@acur{colorTop}%
	\foreach \hb@c [count=\hb@i from 0] in {#2} {%
		\node[draw, minimum width=\hb@aw cm, minimum height=\hb@ah cm, inner sep=0pt,
			font=\hb@afont, text height=1.6ex, text depth=0.3ex]
			(\hb@aid-\hb@i) at (\hb@i*\hb@aw+\hb@aw/2,\hb@ah/2) {\hb@c};
		\ifx\hb@aindex\hb@above
			\node[colorIndex, font=\tiny] at (\hb@i*\hb@aw+\hb@aw/2,\hb@ah+0.14) {\hb@i};
		\fi
		\ifx\hb@aindex\hb@below
			\node[colorIndex, font=\tiny] at (\hb@i*\hb@aw+\hb@aw/2,-0.14) {\hb@i};
		\fi
	}%
	\ifx\hb@aname\@empty\else
		\node[anchor=east, font=\ttfamily\small] at (-0.08,\hb@ah/2) {\hb@aname};
	\fi
	\end{scope}%
	\endgroup
} % \hArray
\def\hb@abegin#1{\begin{scope}[shift={#1}]}
\def\hb@above{above}
\def\hb@below{below}
% hvar: a variable box that holds a reference;  href: the arrow from it
\tikzset{
	hvar/.style={rectangle, draw, thick, fill=white, minimum width=0.6cm, minimum height=0.5cm,
		inner sep=2pt, font=\ttfamily\small},
	href/.style={-{Latex[length=2mm]}, thick, colorIndex!70!black}
}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A Array



%: ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V Grid
% \hGrid[keys]{{r0c0,r0c1,...},{r1c0,r1c1,...},...}   (use inside a tikzpicture)
% A two-dimensional array: one brace group per row, row 0 on top. Rows may have
% different lengths (a ragged array). Cell (r,c) is also a node named (<id>-r-c),
% e.g. (g-1-2.east), for arrows and labels.
% Keys (all optional):
%   id=g            node names g-0-0, g-0-1, ...     (default hG)
%   at={(x,y)}      lower-left corner of cell (0,0)  (default (0,0)); row r is r*height lower
%   width=0.6       box width in cm                  height=0.5   box height in cm
%   name=t          a label left of the grid         index=both, rows, cols or none
%   hot={1/2,0/0}   cells r/c (colorHead)            cur={2/1}    the current cell (colorTop)
%   done={0/0,0/1}  visited cells (colorUsed!55)     unused={2/3} unused cells (colorUnused)
%   rowhot={1}      whole rows (colorHead!45)        colhot={2}   whole columns (colorHead!45)
%   font=\ttfamily\small                             the font of the elements
\pgfkeys{/hGrid/.is family, /hGrid,
	id/.store in=\hb@gid,
	at/.store in=\hb@gat,
	width/.store in=\hb@gw,
	height/.store in=\hb@gh,
	name/.store in=\hb@gname,
	index/.store in=\hb@gindex,
	hot/.store in=\hb@ghot,
	cur/.store in=\hb@gcur,
	done/.store in=\hb@gdone,
	unused/.store in=\hb@gunused,
	rowhot/.store in=\hb@growhot,
	colhot/.store in=\hb@gcolhot,
	font/.store in=\hb@gfont,
	defaults/.style={id=hG, at={(0,0)}, width=0.6, height=0.5, name=, index=both,
		hot=, cur=, done=, unused=, rowhot=, colhot=, font=\ttfamily\small}
}
% \hb@gfill{list of r/c}{color}: fill the cells in the list
\newcommand{\hb@gfill}[2]{%
	\ifx#1\@empty\else
		\foreach \hb@p/\hb@q in #1 {%
			\fill[#2] (\hb@q*\hb@gw,-\hb@p*\hb@gh) rectangle +(\hb@gw,\hb@gh);}%
	\fi}
\NewDocumentCommand{\hGrid}{O{} m}{%
	\begingroup
	\pgfkeys{/hGrid, defaults, #1}%
	\expandafter\hb@abegin\expandafter{\hb@gat}%
	% pass 1: the length of every row, the last row index, the widest row
	\xdef\hb@gmaxc{0}%
	\foreach \hb@row [count=\hb@r from 0] in {#2} {%
		\xdef\hb@glast{\hb@r}%
		\expandafter\xdef\csname hb@glen@\hb@r\endcsname{0}%
		\foreach \hb@c [count=\hb@j] in \hb@row {%
			\expandafter\xdef\csname hb@glen@\hb@r\endcsname{\hb@j}%
			\ifnum\hb@j>\hb@gmaxc\relax \xdef\hb@gmaxc{\hb@j}\fi}}%
	% whole rows and whole columns
	\ifx\hb@growhot\@empty\else
		\foreach \hb@p in \hb@growhot {%
			\fill[colorHead!45] (0,-\hb@p*\hb@gh) rectangle
				+(\csname hb@glen@\hb@p\endcsname*\hb@gw,\hb@gh);}%
	\fi
	\ifx\hb@gcolhot\@empty\else
		\foreach \hb@q in \hb@gcolhot {%
			\foreach \hb@p in {0,...,\hb@glast} {%
				\ifnum\hb@q<\csname hb@glen@\hb@p\endcsname\relax
					\fill[colorHead!45] (\hb@q*\hb@gw,-\hb@p*\hb@gh) rectangle +(\hb@gw,\hb@gh);
				\fi}}%
	\fi
	\hb@gfill\hb@gunused{colorUnused}%
	\hb@gfill\hb@gdone{colorUsed!55}%
	\hb@gfill\hb@ghot{colorHead}%
	\hb@gfill\hb@gcur{colorTop}%
	% the cells
	\foreach \hb@row [count=\hb@r from 0] in {#2} {%
		\foreach \hb@c [count=\hb@j from 0] in \hb@row {%
			\node[draw, minimum width=\hb@gw cm, minimum height=\hb@gh cm, inner sep=0pt,
				font=\hb@gfont, text height=1.6ex, text depth=0.3ex]
				(\hb@gid-\hb@r-\hb@j) at (\hb@j*\hb@gw+\hb@gw/2,-\hb@r*\hb@gh+\hb@gh/2) {\hb@c};}%
		\ifx\hb@gindex\hb@both \hb@growlabel \fi
		\ifx\hb@gindex\hb@rows \hb@growlabel \fi}%
	\ifx\hb@gindex\hb@both \hb@gcollabels \fi
	\ifx\hb@gindex\hb@cols \hb@gcollabels \fi
	\ifx\hb@gname\@empty\else
		\ifx\hb@gindex\hb@both \def\hb@gnx{-0.28}\else
		\ifx\hb@gindex\hb@rows \def\hb@gnx{-0.28}\else \def\hb@gnx{-0.08}\fi\fi
		\node[anchor=east, font=\ttfamily\small] at (\hb@gnx,{\hb@gh*(1-\hb@glast)/2}) {\hb@gname};
	\fi
	\end{scope}%
	\endgroup
} % \hGrid
\newcommand{\hb@growlabel}{%
	\node[colorIndex, font=\tiny] at (-0.14,-\hb@r*\hb@gh+\hb@gh/2) {\hb@r};}
\newcommand{\hb@gcollabels}{%
	\foreach \hb@q in {1,...,\hb@gmaxc} {%
		\node[colorIndex, font=\tiny] at ({(\hb@q-1)*\hb@gw+\hb@gw/2},\hb@gh+0.14) {\the\numexpr\hb@q-1\relax};}}
\def\hb@both{both}
\def\hb@rows{rows}
\def\hb@cols{cols}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A Grid




%: ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V Tree
% TikZ styles for trees drawn with TikZ's child syntax:
%   \begin{tikzpicture}[htree]
%     \node[hnode] {A} child {node[hnode, hhot] {B}} child[missing] child {node[hnode, horder=3] {C}};
%   \end{tikzpicture}
% htree        level distance and edges           hnode   a round node
% hhot         highlighted (the current node)     hdone   already visited
% hleaf        a leaf                             horder=k  small visit number k at the node
% hsquare      a square node (e.g. an operator or a folder)
\tikzset{
	htree/.style={level distance=0.95cm, edge from parent/.style={draw, thick, gray!70},
		every node/.style={font=\small}},
	hnode/.style={circle, draw, thick, fill=white, minimum size=0.58cm, inner sep=1pt},
	hsquare/.style={rectangle, draw, thick, fill=white, minimum size=0.55cm, inner sep=2pt, rounded corners=1pt},
	hhot/.style={fill=colorTop},
	hdone/.style={fill=colorUsed!55},
	hleaf/.style={fill=colorHead!45},
	horder/.style={label={[font=\scriptsize\bfseries, text=red!75!black, inner sep=1pt]above right:#1}}
}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A Tree




%: ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V Commit graph
% TikZ styles for commit graphs (version control):
%   \node[hcommit] (c1) at (0,0) {a1}; \node[hcommit] (c2) at (1.2,0) {b2};
%   \draw[hparent] (c2) -- (c1);                        % a commit points to its parent
%   \node[hbranch, above=2pt of c2] {main};  \node[hheadref, above=2pt of ...] {HEAD};
% hcommit   a commit              hbranch   a branch name       hheadref  HEAD
% htag      a tag                 hparent   child -> parent     hhot / hdone  colour a commit
\tikzset{
	hcommit/.style={circle, draw, thick, fill=white, minimum size=0.62cm, inner sep=0pt, font=\ttfamily\scriptsize},
	hbranch/.style={rectangle, rounded corners=2pt, draw, fill=colorHead!60, font=\ttfamily\scriptsize, inner sep=2pt},
	hheadref/.style={hbranch, fill=colorTop!60},
	htag/.style={hbranch, fill=gray!20, sharp corners},
	hparent/.style={-latex, thick, gray!70!black}
}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A Commit graph


