% ===================================================================== 7 Colors and emphasis
%: ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V colors and emphasis
\definecolor{colorHEmph}{rgb}{.95, .69, .27}  % \hEmph: orange-yellow
\definecolor{colorStop}{rgb}{.99, .27, .27}   % red: stop, wrong
\definecolor{colorGo}{rgb}{.27, .69, .95}     % blue: go, right
\definecolor{colorIndex}{rgb}{.27, .69, .95}  % indices (hblibDatastructures sets its own, purple)
\providecolor{gitred}{RGB}{240,80,50}         % a deck may \definecolor{gitred} again

\newcommand{\hDefined}[1]{\textcolor{red}{#1}}              % a term defined here: \hDefined{reference}
\newcommand{\hEmph}[1]{\textcolor{colorHEmph}{#1}}          % an important word
\newcommand{\hColorBox}{\hEmph}                             % old name of \hEmph
\newcommand{\hIndex}[1]{\textcolor{colorIndex}{${}^{#1}$}}  % a small raised index
\newcommand{\hReference}[1]{\textcolor{blue}{\scriptsize [#1]}}
\newcommand{\hCite}[1]{\textcolor{blue}{\tiny [#1]}}
\newcommand{\hUrl}[1]{\textcolor{blue}{\scriptsize [#1]}}
\newcommand{\hRemark}[1]{\textcolor{orange}{#1}}            % a side remark: \hRemark{macOS}: ...
\newcommand{\hQuestion}[1]{\textcolor{orange}{\textbf{Q.} }#1} % Q. question to the audience

\newcommand{\win}{\textbf{Windows}}
\newcommand{\mac}{\textbf{macOS}}

\newcommand{\hSkipSection}{\small ~\\(skip this section, read at home)}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A colors and emphasis



% ===================================================================== 8 Separators
%: ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V separators
% \hSection[short]{Long}{line}: \section plus a title frame
%   short   in the navigation bar and the outline (optional; default: Long)
%   Long    the title on the frame, \Huge
%   line    under the title, \Large (optional)
%   \hSection[Basics]{Creating and using an array}{Create it, visit it with a loop}
%   \hSection[End]{Summary}
\NewDocumentCommand{\hSection}{O{#2} m g}{%
	\section[#1]{#2}%
	\begin{frame}
		\begin{center}
			\hRemark{\Huge #2}\par\vspace{0.5cm}
			\IfValueT{#3}{\vspace{0.6em}{\hRemark{\Large #3}}\\}%
		\end{center}
	\end{frame}%
}
% \hSubsection{small line}{Title}: \subsection plus a title frame
\newcommand{\hSubsection}[2]{%
	\subsection{#2}%
	\begin{frame}
		\hRemark{\LARGE #1}\par\vspace{0.5cm}
		\begin{center}
			\hRemark{\Huge #2}
		\end{center}
	\end{frame}%
}
% \hSeparator{Title}{line}: a title frame, without a section
\newcommand{\hSeparator}[2]{%
	\begin{frame}
		\begin{center}
			\hRemark{\Huge #1}\\
			#2
		\end{center}
	\end{frame}%
}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A separators



% ===================================================================== 9 Inline code
%: ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V inline code
% \hb@fontshift{N}{text}: text N pt larger (N < 0: smaller)
% https://tex.stackexchange.com/questions/365024/decrease-font-size-by-one-point
\newcommand{\hb@fontshift}[2]{%
	\begingroup
		\fontsize{\dimexpr\f@size pt+#1pt}{\f@baselineskip}\selectfont
		#2%
	\endgroup
}
\newcommand{\hFontLarger}[2]{\hb@fontshift{#1}{#2}}  % \hFontLarger{2}{text}: 2 pt larger

\providecolor{colorHCode}{RGB}{240,80,50}           % a deck may \definecolor it again
% \hCode{text}: inline code, 2 pt smaller, colored. Special characters as in text: \hCode{\{ \}}, \hCode{\_}.
% In a section title the PDF bookmark gets the plain text (\texorpdfstring of hyperref).
\newcommand{\hb@code}[1]{\hb@fontshift{-2}{\texttt{\color{colorHCode}#1}}}
\newcommand{\hCode}[1]{%
	\ifdefined\texorpdfstring \texorpdfstring{\hb@code{#1}}{#1}\else \hb@code{#1}\fi}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A inline code



% ===================================================================== 10 Tables
%: ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V tables
% L{width}: a paragraph column, ragged right:  \begin{tabular}{@{}L{0.3\textwidth}L{0.6\textwidth}@{}}
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A tables



% ===================================================================== 11 Old code listings
%: ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V old code listings
% Kept for older decks. New decks: hblibCodeoutput (\lstcode, \lstcoderightstep, style=codesnippet).
\definecolor{codegreen}{rgb}{0,0.6,0}          % comments
\definecolor{codegray}{rgb}{0.5,0.5,0.5}       % line numbers
\definecolor{codepurple}{rgb}{0.58,0,0.82}     % strings
\definecolor{colorback}{rgb}{0.95,0.95,0.92}   % code background
\definecolor{coloroutput}{rgb}{0.80,0.80,0.80} % output background

% mystyle: tiny font, colored, line numbers. Also the default of every lstlisting.
\lstdefinestyle{mystyle}{
	backgroundcolor=\color{colorback},
	commentstyle=\color{codegreen},
	keywordstyle=\color{blue},
	numberstyle=\tiny\color{codegray},
	stringstyle=\color{codepurple},
	basicstyle=\ttfamily\tiny,
	breakatwhitespace=false,
	breaklines=true,
	captionpos=b,
	keepspaces=true,
	numbers=left,
	numbersep=5pt,
	showspaces=false,
	showstringspaces=false,
	showtabs=false,
	tabsize=2,
	morekeywords={public, class, static, void}
}
\lstset{style=mystyle, literate={\ \ }{{\ }}1} % two spaces are printed as one (halves the indentation)

% \hCodeOutput{name}[dx][dy]:     code from name.src; on slide 2 the output from name.zzz
% \hCodeOutputOnly{name}[dx][dy]: only the output from name.zzz, on slide 2
% The output is centered at (dx cm, dy cm) from the center of the slide (default 2, 0).
% Its box is \hCodeOutputWidth wide; a deck may change it: \renewcommand{\hCodeOutputWidth}{6cm}
% (the listing is in a \parbox: listings 1.11 cannot be set directly in a TikZ node)
\newcommand{\hCodeOutputWidth}{0.42\textwidth}
\NewDocumentCommand{\hCodeOutputOnly}{m O{2} O{0}}{%
	{\tiny
	\begin{tikzpicture}[remember picture,overlay]
		\node[anchor=center, inner sep=0pt] at ($(current page.center) + (#2 cm, #3 cm)$) {%
			\only<2->{%
				\parbox{\hCodeOutputWidth}{%
					\lstinputlisting[style=mystyle, backgroundcolor=\color{coloroutput},
						language={}, frame=trbl, frameround=tttt]{#1.zzz}}%
			}%
		};
	\end{tikzpicture}%
	}%
}
\NewDocumentCommand{\hCodeOutput}{m O{2} O{0}}{%
	{\tiny \lstinputlisting[style=mystyle, language=Java]{#1.src}}%
	\hCodeOutputOnly{#1}[#2][#3]%
}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A old code listings



