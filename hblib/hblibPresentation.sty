%: ~~~~~~~~~~~~~~~~ V HB separator
% \hSection[short]{Long}{line 1}{line 2}: \section plus a title frame
\NewDocumentCommand{\hSection}{O{#2} m m m}{%
	\section[#1]{#2}%
	\begin{frame}
		\begin{center}
			\hRemark{\Huge #2}\\
			#3
			#4
		\end{center}
	\end{frame}%
}
\newcommand{\hSubsection}[2]{%
	\subsection{#2}%
	\begin{frame}
		\hRemark{\LARGE #1}\par\vspace{0.5cm}
		\begin{center}
			\hRemark{\Huge #2}
		\end{center}
	\end{frame}%
}
\newcommand{\hSeparator}[2]{%
	\begin{frame}
		\begin{center}
			\hRemark{\Huge #1}\\
			#2
		\end{center}
	\end{frame}%
}
% ~~~~~~~~~~~~~~~~ A HB separator

%: ~~~~~~~~~~~~~~~~ V HB font size
% \hb@fontshift{N}{text}: text N pt larger (N < 0: smaller)
% https://tex.stackexchange.com/questions/365024/decrease-font-size-by-one-point
\newcommand{\hb@fontshift}[2]{%
	\begingroup
		\fontsize{\dimexpr\f@size pt+#1pt}{\f@baselineskip}\selectfont
		#2%
	\endgroup
}
\newcommand{\hFontLarger}[2]{\hb@fontshift{#1}{#2}} % N pt larger
\newcommand{\hCode}[1]{\hb@fontshift{-2}{\texttt{#1}}} % inline code, 2 pt smaller
% ~~~~~~~~~~~~~~~~ A HB font size

%: ~~~~~~~~~~~~~~~~ V HB table
% L{width}: ragged-right paragraph column
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
% ~~~~~~~~~~~~~~~~ A HB table

