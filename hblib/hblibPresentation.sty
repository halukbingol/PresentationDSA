% ===================================================================== 1 Fonts
%: ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V fonts
\RequirePackage[T1]{fontenc}      % T1 fonts: < > | and accented (Turkish) letters print correctly
\RequirePackage{lmodern}          % Latin Modern: scalable, sharp in PDF viewers
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A fonts



% ===================================================================== 2 Packages
%: ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V packages
\RequirePackage[style=iso,showzone=false]{datetime2} % \today as yyyy-mm-dd; \DTMcurrenttime
\RequirePackage{graphicx}         % \includegraphics (pdf, png, jpg; eps is converted automatically)
\RequirePackage{xcolor}           % colors: \color, \textcolor, \definecolor
\RequirePackage{tikz}             % drawings (also loads pgffor: \foreach)
\usetikzlibrary{positioning,      % right=1cm of a
	matrix,                         % \matrix of nodes
	arrows.meta,                    % -{Latex[length=2mm]}
	calc}                           % ($(a) + (1,0)$), used by \hCodeOutputOnly
\RequirePackage[nomessages]{fp}   % \FPeval: decimal calculations
\RequirePackage{calc}             % \setlength{\x}{\widthof{text} + 2pt}
\RequirePackage{array}            % tables: \newcolumntype, >{...} before a column
\RequirePackage{booktabs}         % tables: \toprule, \midrule, \bottomrule
\RequirePackage{listings}         % program code (styles in section 11 and in hblibCodeoutput)
\RequirePackage[ruled,vlined,linesnumbered]{algorithm2e} % pseudo code (section 3)
\@ifclassloaded{beamer}{}{\RequirePackage{enumitem}}      % lists of handouts; enumitem breaks beamer's lists
\RequirePackage{menukeys}         % \menu{File > Save As}, \keys{Ctrl + C}, \keys{\shift + \cmd + B}
                                  % (it defines \cmd, the Mac command key: use \hCode for commands)
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A packages



% ===================================================================== 3 Algorithms
%: ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V algorithms
% Captions in \small; \Fn{name}{body} gives "function name ... end".
% A deck may add its own keywords (\SetKwFunction, \SetKw) and \DontPrintSemicolon.
\SetAlCapFnt{\small}
\SetAlCapNameFnt{\small}
\SetKwProg{Fn}{function}{}{end}
\@ifclassloaded{beamer}{\resetcounteronoverlays{algocf}}{} % the same algorithm number on every overlay of a frame
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A algorithms



% ===================================================================== 4 Beamer theme
%: ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V beamer theme
% Theme and "i / N" on every frame. A deck can change it after \usepackage{hblibPresentation},
% e.g. \usecolortheme{beaver}
\@ifclassloaded{beamer}{%
	\useoutertheme{split}
	\useinnertheme{rounded}       % also makes blocks rounded
	\usecolortheme{whale}
	\usecolortheme{orchid}
	\setbeamertemplate{navigation symbols}{}
	\setbeamertemplate{page number in head/foot}[totalframenumber] % i / N
}{}
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ A beamer theme



