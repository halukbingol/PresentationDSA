%: ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ V HB Code Listings v2024-02-25
% For code and output read from files, prefer hblibCodeoutput.sty.

% colors for syntax highlighting
\definecolor{codegreen}{rgb}{0,0.6,0}
\definecolor{codegray}{rgb}{0.5,0.5,0.5}
\definecolor{codepurple}{rgb}{0.58,0,0.82}
\definecolor{colorback}{rgb}{0.95,0.95,0.92}
\definecolor{coloroutput}{rgb}{0.80,0.80,0.80}

\lstdefinestyle{mystyle}{
	backgroundcolor=\color{colorback},
	commentstyle=\color{codegreen},
	keywordstyle=\color{blue},
	numberstyle=\tiny\color{codegray},
	stringstyle=\color{codepurple},
	basicstyle=\ttfamily\tiny,
	breakatwhitespace=false,
	breaklines=true,
	captionpos=b,
	keepspaces=true,
	numbers=left,
	numbersep=5pt,
	showspaces=false,
	showstringspaces=false,
	showtabs=false,
	tabsize=2,
	morekeywords={public, class, static, void}
}
\lstset{style=mystyle, literate={\ \ }{{\ }}1} % prints two spaces as one (halves indentation)

%: ~~~~~~~~~~~~~~~~ V \hCodeOutput, \hCodeOutputOnly
% \hCodeOutput{name}[dx][dy]:     code from name.src, output from name.zzz on slide 2
% \hCodeOutputOnly{name}[dx][dy]: only the output from name.zzz on slide 2
% The output is centered at (dx cm, dy cm) from the center of the slide (default 2, 0).
\NewDocumentCommand{\hCodeOutputOnly}{m O{2} O{0}}{%
	{\tiny
	\begin{tikzpicture}[remember picture,overlay]
		\node[anchor=center] at ($(current page.center) + (#2 cm, #3 cm)$) {%
			\only<2->{%
				\lstinputlisting[style=mystyle, backgroundcolor=\color{coloroutput},
					language={}, frame=trbl, frameround=tttt]{#1.zzz}%
			}%
		};
	\end{tikzpicture}%
	}%
}
\NewDocumentCommand{\hCodeOutput}{m O{2} O{0}}{%
	{\tiny \lstinputlisting[style=mystyle, language=Java]{#1.src}}%
	\hCodeOutputOnly{#1}[#2][#3]%
}
% ~~~~~~~~~~~~~~~~ A \hCodeOutput, \hCodeOutputOnly

