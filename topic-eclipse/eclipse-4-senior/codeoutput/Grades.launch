<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<launchConfiguration type="org.eclipse.jdt.launching.localJavaApplication">
    <stringAttribute key="org.eclipse.jdt.launching.PROJECT_ATTR" value="Grades"/>
    <stringAttribute key="org.eclipse.jdt.launching.MAIN_TYPE" value="tr.edu.yeditepe.grades.Main"/>
    <stringAttribute key="org.eclipse.jdt.launching.PROGRAM_ARGUMENTS" value="--term 2026-fall"/>
